# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Google Sheets Integration Configuration
# Target Spreadsheet: https://docs.google.com/spreadsheets/d/1j7J_furrab7YnEoMOJlSlRkTITZ7x0ewG0vQu87vDR4/edit
GOOGLE_SHEETS_SPREADSHEET_ID=1j7J_furrab7YnEoMOJlSlRkTITZ7x0ewG0vQu87vDR4
GOOGLE_SHEETS_SHEET_NAME=Sheet1

# Authentication Option A: Google Cloud Service Account (Recommended for Google Sheets REST API v4)
# Share the Google Sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as "Editor"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Authentication Option B: Google Apps Script Web App Webhook URL (Zero-Cloud-Console option)
# Deploy an Apps Script attached to the spreadsheet as a Web App and paste the /exec URL below:
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
